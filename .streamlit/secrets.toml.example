# 複製此檔案為 secrets.toml 並填入實際值（本機開發用）
# Streamlit Cloud 部署時，在 UI 的 "Secrets" 欄位貼入以下內容

# PostgreSQL（建議使用 Neon 免費雲端 DB：https://neon.tech）
POSTGRES_HOST     = "ep-xxxx.us-east-2.aws.neon.tech"
POSTGRES_PORT     = "5432"
POSTGRES_DB       = "financial_db"
POSTGRES_USER     = "your_user"
POSTGRES_PASSWORD = "your_password"

# API Keys
ANTHROPIC_API_KEY = "sk-ant-..."
FINLAB_API_KEY    = "your_finlab_key"
